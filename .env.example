# Environment Variables
# Copy this file to .env (never commit .env itself) and fill in the values.
# All variables are OPTIONAL for local development.
# In GitHub Actions, set these as repository Variables (not Secrets) — they are not sensitive.

# ── Site URL ────────────────────────────────────────────────────────────────
# The full URL where this site will be hosted.
# Used by Astro to generate canonical URLs and sitemaps.
# Example: https://yourusername.github.io/how-to-documentation
SITE_URL=http://localhost:4321

# ── GitHub Repo URL ─────────────────────────────────────────────────────────
# URL of THIS (engine) repo shown in the site header.
# Example: https://github.com/yourusername/how-to-documentation
GITHUB_REPO_URL=https://github.com

# ── Content Repo Edit URL ────────────────────────────────────────────────────
# Base URL for "Edit this page" links on every article.
# Should point to the base path of the content repo's main branch.
# Starlight appends the file path automatically.
# Example: https://github.com/yourusername/how-to-content/edit/main/
CONTENT_REPO_EDIT_URL=https://github.com/your-username/how-to-content/edit/main/

# ── Content Repo URL (used in GitHub Actions ONLY — keep as a SECRET) ────────
# The HTTPS clone URL of your content repo.
# Add this as a GitHub Actions SECRET (not a variable) in this repo:
#   Settings → Secrets → Actions → New repository secret
#   Name: CONTENT_REPO_URL
#   Value: https://github.com/your-username/how-to-content.git
# (If the content repo is private, use a PAT token in the URL:
#   https://your-pat-token@github.com/your-username/how-to-content.git)
# CONTENT_REPO_URL=
