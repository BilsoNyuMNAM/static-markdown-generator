---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { isProject } from '../../utils/notes';

const allDocs = (await getCollection('docs')).filter((d) => !isProject(d));

// Build tag → count map
const tagCount = new Map<string, { label: string; count: number }>();
for (const doc of allDocs) {
  for (const tag of doc.data.tags ?? []) {
    const slug = tag.toLowerCase();
    const existing = tagCount.get(slug);
    if (existing) {
      existing.count += 1;
    } else {
      tagCount.set(slug, { label: tag, count: 1 });
    }
  }
}

// Sort tags alphabetically
const tags = Array.from(tagCount.entries()).sort(([a], [b]) => a.localeCompare(b));
---

<Layout title="Tags — Bilson's Blog" activeTab="notes">
  <div class="tags-index">
    <div class="masthead">
      <div>
        <h1 class="masthead-title">Tags</h1>
        <p class="masthead-sub">Browse notes by topic</p>
      </div>
      <span class="masthead-total">{tags.length}&nbsp;topics</span>
    </div>

    <div class="tags-grid">
      {tags.map(([slug, { label, count }], i) => (
        <a href={`/tags/${slug}`} class="tag-card">
          <span class="tag-card-index">{String(i + 1).padStart(2, '0')}</span>
          <span class="tag-card-name">{label}</span>
          <span class="tag-card-count">{count}</span>
        </a>
      ))}
    </div>
  </div>
</Layout>
