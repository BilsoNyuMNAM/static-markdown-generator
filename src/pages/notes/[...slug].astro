---
import Layout from '../../layouts/Layout.astro';
import NoteArticle from '../../components/NoteArticle.astro';
import { getCollection } from 'astro:content';
import { isProject } from '../../utils/notes';

export async function getStaticPaths() {
  const notes = (await getCollection('docs')).filter((n) => !isProject(n));
  return notes.map((note) => ({
    params: { slug: note.id },
    props: { note, allNotes: notes },
  }));
}

const { note, allNotes } = Astro.props;
---

<Layout
  title={`${note.data.title} — Bilson's Blog`}
  description={note.data.description}
  activeTab="notes"
>
  <NoteArticle
    note={note}
    allNotes={allNotes}
    basePath="/notes"
    backHref="/"
    backLabel="All Notes"
  />
</Layout>
