---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Bilson's Blog — Projects" activeTab="project">
  <div class="container">
    <div class="notes-list">
      <div class="note-item">
        <div class="note-header-row">
          <h2 class="note-title">How-To Documentation Generator</h2>
          <span class="note-meta">Project &middot; 2026</span>
        </div>
        <p class="note-description">
          A static site generator built with Astro and clean minimalist typography for technical notes and features.
        </p>
      </div>
      <div class="note-item">
        <div class="note-header-row">
          <h2 class="note-title">The Tetris on the Home Page</h2>
          <span class="note-meta">Project &middot; 2026</span>
        </div>
        <p class="note-description">
          The small Tetris board playing itself on this blog's home page is a guideline-accurate Rust engine, a search bot that out-digs Cold Clear 2.
        </p>
      </div>
    </div>
  </div>
</Layout>
