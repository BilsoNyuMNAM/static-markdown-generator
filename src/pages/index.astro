---
import Layout from '../layouts/Layout.astro';
import NotesExplorer from '../components/NotesExplorer.astro';
import { getCollection } from 'astro:content';
import { cleanTitle, resolveTopic, resolveDate, type NoteItem } from '../utils/notes';

const allDocs = await getCollection('docs');

const notes: NoteItem[] = allDocs.map((doc) => {
  const rawTitle = doc.data.title || 'Untitled Note';
  const title = cleanTitle(rawTitle);
  const rawDesc = doc.data.description || (doc.data as any).descryption || '';
  const description = typeof rawDesc === 'string' ? rawDesc.trim() : '';
  const topic = resolveTopic(doc.data.topic, doc.id, doc.data.tags || []);

  const relativePath = doc.filePath ? doc.filePath.replace(/^src\/content\/docs\//, '') : `${doc.id}.md`;
  const dateInfo = resolveDate(doc.data.date, doc.data.year, relativePath);

  return {
    id: doc.id,
    slug: doc.id,
    url: `/notes/${doc.id}`,
    rawTitle,
    title,
    description,
    topic,
    tags: (doc.data.tags || []).map((t: string) => t.toLowerCase().trim()),
    date: dateInfo.dateStr,
    formattedDate: dateInfo.formattedDate,
    shortDate: dateInfo.shortDate,
    monthYear: dateInfo.monthYear,
    timestamp: dateInfo.timestamp,
    series: doc.data.series,
    order: doc.data.order,
  };
});

// Default sort: newest first
notes.sort((a, b) => b.timestamp - a.timestamp);
---

<Layout title="Bilson's Blog — Notes" activeTab="notes">
  <NotesExplorer notes={notes} />
</Layout>
